# Optional. Copy to .env to set keys at startup, or just paste them into Lateral's Settings (gear icon) — Settings wins.
# Tavily is the one Lateral really needs (web search for evidence, briefs, and blocked-page image recovery): https://app.tavily.com
TAVILY_API_KEY=

# Optional cloud LLM providers (Lateral works fully with local Ollama alone)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# Optional: podcast transcription helper (start it with: LATERAL_WORKER_TOKEN=<same secret> python tools/transcribe_worker.py)
# LATERAL_TRANSCRIBE_URL=http://host.docker.internal:3007
# LATERAL_TRANSCRIBE_TOKEN=

# Optional: change the host ports
# LATERAL_PORT=8080
# LATERAL_PROXY_PORT=3005
