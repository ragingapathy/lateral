<style id='wpp-header-search-hit-area-inline-css' type='text/css'>

.tdb-head-search-btn{position:relative;}
.tdb-head-search-btn::before{
	content:"";
	position:absolute;
	top:50%;
	left:50%;
	width:24px;
	height:24px;
	transform:translate(-50%,-50%);
}
