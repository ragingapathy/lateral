<style id="wpp-billboard-reserve-css">
@media screen{
	/* Hold the billboard's space on a property the vendor never writes. */
	:root{padding-top:var(--wpp-bb-reserve,25vw);}

	/* The vendor's injected bookkeeping wrapper is an empty line box in normal
	   flow (div > inline span, line-height 18.4px) worth ~18px. Zero the strut
	   so it stops pushing the document down. Real creative content keeps its
	   own box, so an HTML placement that actually renders is unaffected. */
	body>toledocitypaper-zone-container{line-height:0;font-size:0;}
	body>toledocitypaper-zone-container *{vertical-align:top;}

	/* Hold the header menu's settled height. It grows 28 -> 34 -> 67px as
	   tagDiv's stylesheets arrive (7 -> 133 of them), which moves the toggle
	   20px on its own. Settled heights measured across widths and templates:
	   67.4px at >=1019px, 62.6px from 768 to 1018px, and the desktop header is
	   display:none at <=767px so no reservation is wanted there. */
	@media (min-width:1019px){
		.td-header-desktop-wrap .tdb_header_menu{min-height:67.4px;}
	}
	@media (min-width:768px) and (max-width:1018px){
		.td-header-desktop-wrap .tdb_header_menu{min-height:62.6px;}
	}
}
</style>
<script id="wpp-billboard-reserve-js">
(function(){
	var d=document,de=d.documentElement,released=false,KEY='wppBillboardZone';

	function release(why){
		if(released){return;}
		released=true;
		de.style.setProperty('--wpp-bb-reserve','0px');
		de.setAttribute('data-wpp-bb',why);
	}
	function remember(v){try{window.localStorage.setItem(KEY,v);}catch(e){}}
	function recall(){try{return window.localStorage.getItem(KEY);}catch(e){return null;}}
	function px(v){var n=parseFloat(v||'');return isNaN(n)?0:n;}

	/* Repeat visitors who never get the ad (ad blocker, vendor blocked on their
	   network) would otherwise get a reserved band and an upward collapse on
	   EVERY page. Before v1.2.0 that was a new shift for a group that
	   previously had a stable page. Remember the last known outcome and skip
	   the reservation entirely for them. Worst case the flag is stale, which
	   costs one load of the old behaviour and then self-corrects. */
	if(recall()==='absent'){release('remembered-absent');}

	/* Handover. A POSITIVE inline margin means the vendor has taken ownership
	   with a real value, so drop our padding in this same microtask (before
	   paint, so the swap is invisible) and then get out of the way for good so
	   its scroll-collapse still works.

	   A value of 0 is NOT treated as "no ad". Measured over 10 cold loads the
	   vendor ALWAYS writes 0 first and the real value 34ms to 1549ms later, so
	   0 is a precursor, not a verdict. It does start a short grace timer: if no
	   positive value follows, the zone really did come back empty and the
	   reservation is released then, which is far quicker and far more accurate
	   than any fixed backstop. */
	var zeroSeen=false;
	function sawZero(){
		if(zeroSeen||released){return;}
		zeroSeen=true;
		// Max observed 0 -> positive gap was 1549ms; 3s leaves ~2x headroom.
		setTimeout(function(){release('no-fill');},3000);
	}
	function watch(){
		if(!d.body){return;}
		var cur=d.body.style.marginTop;
		if(px(cur)>0){remember('present');release('vendor');return;}
		var mo=new MutationObserver(function(){
			if(released){return;}
			var v=d.body.style.marginTop;
			if(px(v)>0){
				remember('present');
				release('vendor');
				mo.disconnect();
			}else if(v!==''){
				sawZero();
			}
		});
		mo.observe(d.body,{attributes:true,attributeFilter:['style']});
		if(cur!==''){sawZero();}
	}
	if(d.body){watch();}else{d.addEventListener('DOMContentLoaded',watch);}

	/* The vendor never arrives at all: ad blocker, outage, DNS failure, JS
	   error. Nothing would ever override the reservation, so collapse it.
	   Resource errors do not bubble, hence the capture phase. */
	window.addEventListener('error',function(e){
		var t=e.target;
		if(t&&t.tagName==='SCRIPT'&&/init-2|broadstreet/i.test(t.src||'')){
			remember('absent');
			release('script-error');
		}
	},true);
	d.addEventListener('DOMContentLoaded',function(){
		if(!d.querySelector('script[src*="init-2"],script[id^="broadstreet-init"]')){
			remember('absent');
			release('script-absent');
		}
	});
	/* Absolute backstop, for a case none of the above catches: the script runs,
	   writes nothing at all, ever. Deliberately far out. Measured time to the
	   real margin across 10 cold loads was min 2.9s, median 6.6s and MAX
	   20.3s, so anything shorter fires on a slow-but-working load and causes
	   the exact 360px jump this plugin exists to remove. A fixed 8s backstop
	   was measured doing precisely that, and v1.1.0's 12s would have too.
	   Holding the space too long only shows a blank band on a stable page;
	   releasing too early breaks the page under the user. Prefer the former. */
	setTimeout(function(){release('timeout');},30000);

	/* ------------------------------------------------------------------
	 * DELIBERATELY NOT DONE HERE: rescuing clicks made before the search JS
	 * binds.
	 *
	 * Holding the page still is necessary but not sufficient. tdbSearch.js is
	 * script #32 of 52 in the footer, so on a cold load the toggle is inert for
	 * roughly the first second (it tracks overall page load, so longer on a
	 * slow connection). A click in that window lands on the right element and
	 * still does nothing.
	 *
	 * A capture-phase listener that recorded such a click and replayed it once
	 * the handler existed was built and tested against the live site, and it is
	 * NOT shipped because it does not work. Instrumented in the capture phase
	 * (bubble-phase observation is useless here, tagDiv's handler calls
	 * stopPropagation and hides the result), the replay demonstrably fires as
	 * an untrusted click on the correct element, after jQuery._data confirms
	 * the click handler is bound, and the search box still never opens. The
	 * cause was not identified within the time available.
	 *
	 * Shipping a listener that reliably intercepts and reliably fails to
	 * deliver would swallow the user's click and add an unexplained moving
	 * part, which is worse than leaving the pre-existing behaviour alone.
	 *
	 * The binding delay is a genuine second cause of "search isn't working" and
	 * it is NOT fixed by this plugin. It is a page-weight problem (52 scripts,
	 * 133 stylesheets) and belongs in its own performance ticket.
	 * ------------------------------------------------------------------ */
})();
</script>
